# Models & weights: never committed.
# NB: no trailing slash — `models` may be a SYMLINK to external storage, and
# `models/` would only match a real directory. Same gotcha as qwen-tts.
models
# models-local/ is the one-at-a-time local staging cache used for benchmarks
# (scripts/use_model.sh). Real directory, real weights, never committed.
models-local
